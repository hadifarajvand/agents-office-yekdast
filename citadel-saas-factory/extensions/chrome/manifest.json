{
  "manifest_version": 3,
  "name": "Citadel Agent Assistant",
  "version": "1.0.0",
  "description": "Browse-assist agent powered by the Citadel SaaS Factory backend",
  "permissions": ["activeTab", "sidePanel", "storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Citadel Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
