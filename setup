#!/usr/bin/env bash
# One-command preparation (macOS / Linux). Safe to re-run. It installs dependencies, builds the
# page, and tells you what is missing. It does NOT start the office, the database, 9router or
# any container, and it never touches your Docker or network setup.
set -uo pipefail
BOLD=$(tput bold 2>/dev/null || true); GREEN=$(tput setaf 2 2>/dev/null || true); RED=$(tput setaf 1 2>/dev/null || true); AMBER=$(tput setaf 3 2>/dev/null || true); RESET=$(tput sgr0 2>/dev/null || true)
ok(){ echo "${GREEN}✓${RESET} $1"; }; warn(){ echo "${AMBER}! $1${RESET}"; }; fail(){ echo "${RED}✗ $1${RESET}"; exit 1; }; step(){ echo; echo "${BOLD}$1${RESET}"; }
ROOT="$(cd "$(dirname "$0")" && pwd)"; cd "$ROOT"

step "1/4 Tools"
command -v git >/dev/null 2>&1 || fail "git is missing."
ok "git"
command -v node >/dev/null 2>&1 || fail "Node.js 20+ is missing (https://nodejs.org)."
[[ "$(node -e 'console.log(process.versions.node.split(".")[0])')" -ge 20 ]] || fail "Node 20+ required (you have $(node --version))."
ok "Node $(node --version)"
PY=$(command -v python3.12 || command -v python3.11 || command -v python3 || true)
[[ -n "$PY" ]] || fail "Python 3.11+ is missing."
"$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' || fail "Python 3.11+ required (you have $("$PY" --version))."
ok "$("$PY" --version)"
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then ok "Docker is running"
else warn "Docker is not running (or not installed): needed for Postgres, the egress proxy and build jobs. Not needed for the tests."; fi

step "2/4 Python environment (backend/.venv)"
[[ -d backend/.venv ]] || "$PY" -m venv backend/.venv || fail "could not create backend/.venv"
backend/.venv/bin/pip install -q --disable-pip-version-check -r backend/requirements-dev.txt || fail "pip install failed — run: backend/.venv/bin/pip install -r backend/requirements-dev.txt"
ok "backend dependencies"

step "3/4 Page + configuration"
npm ci --no-fund --no-audit >/dev/null 2>&1 || npm install --no-fund --no-audit >/dev/null 2>&1 || fail "npm install failed — run it by hand to see why"
node build.mjs >/dev/null 2>&1 || fail "build failed — run: node build.mjs"
ok "page built (dist/command-centre-v2.html)"
if [[ ! -f .env.local ]]; then cp .env.example .env.local && ok ".env.local created from .env.example — fill in the values (it is gitignored)"; else ok ".env.local exists"; fi

step "4/4 Checks"
if PATH="$ROOT/backend/.venv/bin:$PATH" node check.mjs >/tmp/agents-office-setup-check.log 2>&1; then ok "npm run check passed"
else warn "npm run check reported problems — see /tmp/agents-office-setup-check.log (a missing browser for the page smoke is the usual cause)"; fi

echo; echo "${GREEN}${BOLD}Prepared.${RESET} Nothing is running. To run it (details in PLAN.md section 11):"
echo "  1. 9router running on this machine, REQUIRE_API_KEY on; put its key in .env.local"
echo "  2. docker compose up -d postgres egress router-gateway"
echo "  3. backend/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 4520"
echo "  4. open http://localhost:4520"
