# Names only: real values live in the deployment's environment, never in the repository.
# Empty DATABASE_URL = an in-process PGlite database (dev, tests, preview checks).
DATABASE_URL=
# 1 = allow running without DATABASE_URL in production (data is lost on restart): checks and previews only.
EPHEMERAL_DB=
# 32+ random characters; production refuses to start without it.
BETTER_AUTH_SECRET=
# The public URL of the app, e.g. https://app.example.com
BETTER_AUTH_URL=http://127.0.0.1:3000
# Payments (test mode keys only until the owner promotes to production).
STRIPE_SECRET_KEY=
