{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "next build && node scripts/standalone.mjs",
    "start": "node .next/standalone/server.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
