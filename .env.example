# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Secrets are read from these variable NAMES; office.config.json only names them.

# --- 9router (the local model proxy on this machine) ---
ROUTER_BASE_URL=http://host.docker.internal:20128   # no trailing /v1; use http://127.0.0.1:20128 when the app runs natively
ROUTER_API_KEY=replace-me                            # the key from the 9router dashboard; turn REQUIRE_API_KEY on there
ROUTER_FORMAT=openai                                 # openai | anthropic
ROUTER_UPSTREAM=http://host.docker.internal:20128    # where router-gateway forwards job traffic (compose only)

# --- the office API ---
AO_API_TOKEN=replace-me          # optional but recommended: required as X-AO-Token on every /api call
AO_WORKER=fake                   # fake | claude_code | mini_swe | openhands (set after the bake-off)

# --- Postgres (compose publishes it on 127.0.0.1 only) ---
DATABASE_URL=postgresql://office:office@127.0.0.1:5432/office
POSTGRES_PASSWORD=office         # change it; keep DATABASE_URL in step

# --- brain folder (notes, skills, feedback, routines, audit log) ---
AO_BRAIN=./brain-yekdast

# --- Dokploy (on the VPS) ---
DOKPLOY_URL=https://dokploy.example.com
DOKPLOY_API_KEY=replace-me
DOKPLOY_PREVIEW_DOMAIN=preview.example.com           # previews get <job>.<this domain>
PREVIEW_REPO_URL=https://github.com/OWNER/previews.git   # private repo Dokploy builds previews from
PREVIEW_REPO_TOKEN=replace-me                        # fine-grained token: write on THAT repo only

# --- GitHub (read-only, for agents) ---
GITHUB_TOKEN=replace-me          # fine-grained: Contents read + Metadata read, chosen repos only
