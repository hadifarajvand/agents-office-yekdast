# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Points at your local model router/proxy (e.g. claude-code-router) running on the HOST machine,
# not inside a container. Docker reaches the host via host.docker.internal (wired in
# docker-compose.yml's extra_hosts for Linux compatibility; native on Docker Desktop/Mac).
ANTHROPIC_BASE_URL=http://host.docker.internal:20128/v1
ANTHROPIC_AUTH_TOKEN=replace-me
ANTHROPIC_DEFAULT_FABLE_MODEL=cc/claude-fable-5[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=cc/claude-opus-5[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=cc/claude-sonnet-5[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=cc/claude-haiku-4-5-20251001[1m]

DATABASE_URL=postgresql+asyncpg://office:office@postgres:5432/office
REDIS_URL=redis://redis:6379/0
BRAIN_PATH=/brain-yekdast
PORT=4520
